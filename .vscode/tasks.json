{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dafny: Build to ./dfy_out/",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "${config:dafny.dafnyPath}",
                "build",
                "--target:cs",
                "--output:./dfy_out/",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}